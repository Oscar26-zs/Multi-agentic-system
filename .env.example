# Variables de entorno necesarias para autonomous-swe-team (SOLO placeholders, sin valores reales).
# Copiar este archivo a .env y completar con credenciales propias. Nunca commitear .env ni poner keys aqui.

# --- LLM: fallback multi-proveedor (agents/llm_factory.py) ---
# build_llm()/invoke_structured() prueban estos 4 proveedores EN ESTE ORDEN
# (con un ping o, para salida estructurada, la llamada real) hasta que uno
# responda. No hace falta elegir uno solo: completa las keys de los que
# tengas y el sistema salta solo al siguiente si el actual falla (cuota
# agotada, modelo caido, key invalida). Ninguno es obligatorio individualmente,
# pero al menos UNO debe estar configurado.

# 1. NVIDIA NIM (https://build.nvidia.com) — free tier real. Confirma el ID
# exacto del modelo contra GET https://integrate.api.nvidia.com/v1/models
# (el catalogo cambia; nemotron-3.5-lightning-30b-a3b es el vigente al
# momento de escribir esto).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

# 2. Groq (https://console.groq.com/keys) — free tier real. Confirma modelos
# vigentes contra GET https://api.groq.com/openai/v1/models.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=openai/gpt-oss-120b

# 3. Google AI Studio / Gemini (https://aistudio.google.com/apikey) — free
# tier real, sin tarjeta. La API key real NO tiene el formato "AQ...." de un
# token de sesion/OAuth: empieza con "AIzaSy".
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL_NAME=gemini-3.6-flash

# 4. OpenRouter (https://openrouter.ai/keys) — ultimo en el orden (red de
# seguridad): free tier compartido entre TODOS los modelos :free de la
# cuenta (50/dia, o 1000/dia con >=10 USD en creditos cargados).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning:free

# --- Langfuse (observabilidad) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RAG / Vector store ---
VECTOR_STORE=chroma
VECTOR_STORE_PERSIST_DIR=./chroma_db
EMBEDDINGS_MODEL_NAME=

# --- MCP -> repo MVC ---
MVC_GIT_REPO_URL=
REPO_TARGET_PATH=./_sandbox/Solicitud_de_Vacaciones
