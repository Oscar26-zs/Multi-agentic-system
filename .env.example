# Variables de entorno necesarias para autonomous-swe-team (SOLO placeholders, sin valores reales).
# Copiar este archivo a .env y completar con credenciales propias. Nunca commitear .env ni poner keys aqui.

# --- LLM: proveedor activo ---
# agents/llm_factory.py lee estas 3 variables de forma generica (nombres
# historicos de cuando solo existia OpenRouter, pero sirven para cualquier
# proveedor compatible con la API de OpenAI). Completar UN solo bloque; los
# otros dos quedan como referencia para saltar de proveedor si el activo
# se queda sin cuota gratuita.

# Opcion A: Groq (https://console.groq.com/keys) — free tier real, 1000
# requests/dia en openai/gpt-oss-120b u openai/gpt-oss-20b.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=openai/gpt-oss-120b

# Opcion B: OpenRouter (https://openrouter.ai/keys) — free tier compartido
# entre TODOS los modelos :free de la cuenta (50/dia, o 1000/dia con >=10 USD
# en creditos cargados).
# OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning:free

# Opcion C: Google Gemini via AI Studio (https://aistudio.google.com/apikey)
# — free tier real, sin tarjeta.
# OPENROUTER_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-2.5-flash

# --- Langfuse (observabilidad) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RAG / Vector store ---
VECTOR_STORE=chroma
VECTOR_STORE_PERSIST_DIR=./chroma_db
EMBEDDINGS_MODEL_NAME=

# --- MCP -> repo MVC ---
MVC_GIT_REPO_URL=
REPO_TARGET_PATH=./_sandbox/Solicitud_de_Vacaciones
