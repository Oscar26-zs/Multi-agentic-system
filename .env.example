# Variables de entorno necesarias para autonomous-swe-team (sin valores reales).
# Copiar este archivo a .env y completar con credenciales propias. Nunca commitear .env.

# --- Proveedor LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=

# --- Langfuse (observabilidad) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Vector store (RAG) ---
VECTOR_STORE=chroma|faiss
VECTOR_STORE_PERSIST_DIR=
EMBEDDINGS_MODEL_NAME=

# --- Servidor MCP ---
MCP_TRANSPORT=stdio|sse
REPO_TARGET_PATH=
