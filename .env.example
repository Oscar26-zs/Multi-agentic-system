# Variables de entorno necesarias para autonomous-swe-team (SOLO placeholders, sin valores reales).
# Copiar este archivo a .env y completar con credenciales propias. Nunca commitear .env ni poner keys aqui.

# --- LLM via OpenRouter (modelos :free gratuitos) ---
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning:free

# --- Langfuse (observabilidad) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RAG / Vector store ---
VECTOR_STORE=chroma
VECTOR_STORE_PERSIST_DIR=./chroma_db
EMBEDDINGS_MODEL_NAME=

# --- MCP -> repo MVC ---
MVC_GIT_REPO_URL=
REPO_TARGET_PATH=./_sandbox/Solicitud_de_Vacaciones
